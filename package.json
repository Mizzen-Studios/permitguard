{
  "name": "permitguard",
  "version": "0.1.0",
  "private": true,
  "description": "Human-confirmed LOTO permit decision support for Atlassian Forge",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check static/permit-panel/app.js",
    "test:ui": "node static/permit-panel/smoke.cjs",
    "build:probe": "node src/forge/build-probe.cjs",
    "build": "node src/forge/build-probe.cjs && node src/ui-build.cjs",
    "test:contracts": "node --test static/permit-app/static.test.cjs"
  },
  "dependencies": {
    "@forge/api": "^8.5.0",
    "@forge/bridge": "^7.3.0",
    "@forge/kvs": "^2.1.2",
    "@forge/realtime": "^1.0.3",
    "@forge/resolver": "^2.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "overrides": {
    "prosemirror-view": "1.42.9",
    "glob": "14.0.6",
    "minimatch": "11.0.8"
  }
}
